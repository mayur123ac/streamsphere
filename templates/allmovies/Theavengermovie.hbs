<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Ballerina - Full Movie</title>
  <link rel="stylesheet" href="/css/movie.css" />
  <link rel="stylesheet" href="/css/playmovie.css" />

  <style>
    .player-container {
      height: 100dvh !important;
      width: 100%;
      position: relative;
      overflow: hidden;
      background: black;
      user-select: none;
    }

    .controls {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      box-sizing: border-box;
      padding-bottom: max(10px, env(safe-area-inset-bottom));
      padding-left: 20px;
      padding-right: 20px;
      z-index: 2147483647;
      display: flex;
      align-items: center;
    }

    .zoomed {
      object-fit: cover !important;
      transform: scale(1.12);
    }

    .loader {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 50px;
      height: 50px;
      border: 5px solid rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      border-top-color: #fff;
      animation: spin 1s ease-in-out infinite;
      z-index: 25;
      display: none;
      pointer-events: none;
    }

    @keyframes spin {
      to { transform: translate(-50%, -50%) rotate(360deg); }
    }

    .skip-btn {
      font-size: 18px;
      font-weight: bold;
      color: white;
      cursor: pointer;
      margin: 0 15px;
      user-select: none;
      transition: transform 0.1s;
      font-family: sans-serif;
    }
    .skip-btn:active { transform: scale(0.9); }

    .progress-bar { cursor: pointer; flex-grow: 1; margin: 0 15px; }
    
    .btn {
      cursor: pointer;
      margin: 0 10px;
      font-size: 18px;
      user-select: none;
    }
    
    /* Highlight Cast Button when active */
    .cast-active { color: #4285F4 !important; }
  </style>
</head>

<body>
  <div class="player-container">
    
    <div id="loader" class="loader"></div>

    <div class="top-overlay" id="topOverlay">
      <div class="rating">| <h1></h1></div>
      <div class="title">The Avengers 2012</div>
      <div class="desc hidden1">Action • Thriller • Revenge • 4K HDR</div>
    </div>
    
    <video id="moviePlayer" preload="metadata" playsinline>
      <source
        src="https://my-movie-bucket01stremesphere.s3.eu-north-1.amazonaws.com/The+Avengers+(2012)+2160p+4K+BluRay+x265+10bit+HDR++%5BHindi+DD5.1+640Kbps+%2B+English+7.1%5D+Esub+~+PSA.mkv"
        type="video/mp4" />
      <track label="English" kind="subtitles" srclang="en" src="/subtitles/en.vtt" default />
      <track label="Hindi" kind="subtitles" srclang="hi" src="/subtitles/hi.vtt" />
      Your browser does not support HTML5 video.
    </video>

    <div class="controls bottom-overlay hidden1" id="controls">
      <span class="skip-btn" id="rewindBtn">◀◀</span>
      <span class="btn" id="playPause">▶</span>
      <span class="skip-btn" id="forwardBtn">▶▶</span>

      <div class="time" id="time">0:00 / 0:00</div>
      
      <div class="progress-bar" id="progressBar">
        <div class="progress" id="progress"></div>
      </div>
      
      <span class="btn" id="mute">🔊</span>
      <span class="btn" id="zoom">🔍</span>
      <span class="btn" id="castBtn" title="Cast to TV">📺</span>
      <span class="btn" id="fullscreen">⛶</span>
    </div>
  </div>

  <script>
    const movie = document.getElementById("moviePlayer");
    const playPause = document.getElementById("playPause");
    const mute = document.getElementById("mute");
    const fullscreen = document.getElementById("fullscreen");
    const progressBar = document.getElementById("progressBar");
    const progress = document.getElementById("progress");
    const timeLabel = document.getElementById("time");
    const topOverlay = document.getElementById("topOverlay");
    const controls = document.getElementById("controls");
    const zoomBtn = document.getElementById("zoom"); 
    const loader = document.getElementById("loader");
    const rewindBtn = document.getElementById("rewindBtn");
    const forwardBtn = document.getElementById("forwardBtn");
    const castBtn = document.getElementById("castBtn");

    let hideControlsTimeout;
    let isZoomed = false; 
    let isDragging = false; 

    const formatTime = (sec) => {
      if(!sec || isNaN(sec)) return "0:00";
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return `${m}:${s.toString().padStart(2, "0")}`;
    };

    /* --- STANDARD PLAYER CONTROLS --- */
    movie.addEventListener('waiting', () => loader.style.display = 'block');
    movie.addEventListener('seeking', () => loader.style.display = 'block');
    movie.addEventListener('playing', () => loader.style.display = 'none');
    movie.addEventListener('canplay', () => loader.style.display = 'none');

    rewindBtn.onclick = (e) => { e.stopPropagation(); movie.currentTime = Math.max(0, movie.currentTime - 10); };
    forwardBtn.onclick = (e) => { e.stopPropagation(); movie.currentTime = Math.min(movie.duration, movie.currentTime + 10); };

    const updateProgress = (clientX) => {
      const rect = progressBar.getBoundingClientRect();
      let percent = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
      progress.style.width = (percent * 100) + "%";
      if(movie.duration) timeLabel.textContent = `${formatTime(percent * movie.duration)} / ${formatTime(movie.duration)}`;
      return percent;
    };

    const handleDragEnd = (clientX) => {
      if (isDragging) {
        isDragging = false;
        if(movie.duration) movie.currentTime = updateProgress(clientX) * movie.duration;
      }
    };

    progressBar.addEventListener('mousedown', (e) => { e.stopPropagation(); isDragging = true; updateProgress(e.clientX); });
    document.addEventListener('mousemove', (e) => { if (isDragging) updateProgress(e.clientX); });
    document.addEventListener('mouseup', (e) => handleDragEnd(e.clientX));

    progressBar.addEventListener('touchstart', (e) => { e.stopPropagation(); isDragging = true; updateProgress(e.touches[0].clientX); }, { passive: false });
    document.addEventListener('touchmove', (e) => { if (isDragging) updateProgress(e.touches[0].clientX); }, { passive: false });
    document.addEventListener('touchend', (e) => handleDragEnd(e.changedTouches[0].clientX));

    movie.ontimeupdate = () => {
      if (!isDragging && movie.duration) {
        progress.style.width = (movie.currentTime / movie.duration) * 100 + "%";
        timeLabel.textContent = `${formatTime(movie.currentTime)} / ${formatTime(movie.duration)}`;
      }
    };

    playPause.onclick = (e) => {
      e.stopPropagation();
      movie.paused ? movie.play() : movie.pause();
      playPause.textContent = movie.paused ? "▶" : "⏸";
    };

    mute.onclick = (e) => {
      e.stopPropagation();
      movie.muted = !movie.muted;
      mute.textContent = movie.muted ? "🔇" : "🔊";
    };

    fullscreen.onclick = (e) => {
      e.stopPropagation();
      const parent = movie.parentElement;
      if (parent.requestFullscreen) parent.requestFullscreen();
      else if (parent.webkitRequestFullscreen) parent.webkitRequestFullscreen();
      else if (parent.msRequestFullscreen) parent.msRequestFullscreen();
    };

    const showControls = () => {
      controls.style.opacity = 1; topOverlay.style.opacity = 1;
      clearTimeout(hideControlsTimeout);
      hideControlsTimeout = setTimeout(() => {
        if(!movie.paused && !isDragging) { controls.style.opacity = 0; topOverlay.style.opacity = 0; }
      }, 3000);
    };

    document.addEventListener("mousemove", showControls);
    document.addEventListener("touchstart", showControls);
    document.addEventListener("click", (e) => { if (!e.target.closest(".controls")) showControls(); });

    zoomBtn.onclick = (e) => {
      e.stopPropagation();
      isZoomed = !isZoomed;
      movie.classList.toggle("zoomed", isZoomed);
      zoomBtn.textContent = isZoomed ? "🧭" : "🔍";
    };

    /* ===================== NEW CHROMECAST LOGIC ===================== */
    
    // 1. Initialize the API once the script loads
    window.__onGCastApiAvailable = function(isAvailable) {
      if (isAvailable) {
        console.log("Cast API is available. Initializing context...");
        cast.framework.CastContext.getInstance().setOptions({
          receiverApplicationId: chrome.cast.media.DEFAULT_MEDIA_RECEIVER_APP_ID,
          autoJoinPolicy: chrome.cast.AutoJoinPolicy.ORIGIN_SCOPED
        });
      }
    };

    // 2. Handle the Custom Button Click
    castBtn.addEventListener("click", function(e) {
      e.stopPropagation();
      
      console.log("Cast button clicked.");

      if (!window.cast || !window.cast.framework) {
        console.error("Cast framework not detected.");
        alert("Chromecast is not available. Ensure you are on Chrome and using a secure local server (HTTPS/localhost).");
        return;
      }

      const context = cast.framework.CastContext.getInstance();
      
      // Request a session to open the Chrome Cast Menu
      context.requestSession().then(
        function() {
          console.log("Cast session created successfully.");
          loadMediaToCast();
        },
        function(error) {
          console.error("Cast session failed or was canceled by user:", error);
        }
      );
    });

    // 3. Load the video onto the TV
    function loadMediaToCast() {
      const castSession = cast.framework.CastContext.getInstance().getCurrentSession();
      if (!castSession) {
        console.error("No active cast session found to load media into.");
        return;
      }

      console.log("Loading media to Chromecast...");
      
      // Grab the exact video URL from the source
      const videoSrc = document.querySelector('#moviePlayer source').src;
      
      // Tell Chromecast what type of file this is
      const mediaInfo = new chrome.cast.media.MediaInfo(videoSrc, 'video/mp4');
      const request = new chrome.cast.media.LoadRequest(mediaInfo);
      
      // Start the TV at the exact timestamp the user is currently watching
      request.currentTime = movie.currentTime; 

      castSession.loadMedia(request).then(
        function() {
          console.log("Media successfully loaded on TV!");
          movie.pause(); // Pause the laptop/phone video
          playPause.textContent = "▶";
          castBtn.classList.add("cast-active"); // Highlight the button
        },
        function(errorCode) {
          console.error("Failed to load media on TV. Error code:", errorCode);
          alert("The TV failed to load the video. Check the console for details.");
        }
      );
    }
  </script>
  
  <script src="/js/css.js"></script>
  
  <script type="text/javascript" src="https://www.gstatic.com/cv/js/sender/v1/cast_sender.js?loadCastFramework=1"></script>

</body>
</html>